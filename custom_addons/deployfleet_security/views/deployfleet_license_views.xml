<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_deployfleet_license_form" model="ir.ui.view">
        <field name="name">deployfleet.license.form</field>
        <field name="model">deployfleet.license</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activate"
                            invisible="state == 'active'" class="btn-primary"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Expired" bg_color="text-bg-danger"
                            invisible="state != 'expired'"/>
                    <widget name="web_ribbon" title="Invalid" bg_color="text-bg-danger"
                            invisible="state != 'invalid'"/>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="license_key"/>
                        <field name="state"/>
                        <field name="valid_until"/>
                        <field name="max_users"/>
                    </group>
                    <field name="notes" placeholder="Internal notes..."/>
                    <notebook>
                        <page string="Activity Log">
                            <field name="log_ids" readonly="1">
                                <list>
                                    <field name="create_date"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_deployfleet_license_list" model="ir.ui.view">
        <field name="name">deployfleet.license.list</field>
        <field name="model">deployfleet.license</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="state"/>
                <field name="valid_until"/>
            </list>
        </field>
    </record>

    <record id="action_deployfleet_license" model="ir.actions.act_window">
        <field name="name">Licenses</field>
        <field name="res_model">deployfleet.license</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_deployfleet_license"
              name="Licenses"
              parent="deployfleet_core.menu_deployfleet_root"
              action="action_deployfleet_license"
              groups="base.group_system"
              sequence="100"/>
</odoo>
