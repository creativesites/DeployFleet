<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_privilege_deployfleet_operations" model="res.groups.privilege">
        <field name="name">DeployFleet Operations</field>
    </record>

    <record id="group_deployfleet_driver" model="res.groups">
        <field name="name">DeployFleet Driver</field>
        <field name="privilege_id" ref="group_privilege_deployfleet_operations"/>
    </record>

    <record id="group_deployfleet_dispatcher" model="res.groups">
        <field name="name">DeployFleet Dispatcher</field>
        <field name="privilege_id" ref="group_privilege_deployfleet_operations"/>
        <field name="implied_ids" eval="[(4, ref('group_deployfleet_driver'))]"/>
    </record>

    <record id="group_deployfleet_manager" model="res.groups">
        <field name="name">DeployFleet Fleet Manager</field>
        <field name="privilege_id" ref="group_privilege_deployfleet_operations"/>
        <field name="implied_ids" eval="[(4, ref('group_deployfleet_dispatcher'))]"/>
    </record>

    <record id="group_deployfleet_owner" model="res.groups">
        <field name="name">DeployFleet Owner</field>
        <field name="privilege_id" ref="group_privilege_deployfleet_operations"/>
        <field name="implied_ids" eval="[(4, ref('group_deployfleet_manager'))]"/>
    </record>

    <record id="group_deployfleet_hr_payroll_officer" model="res.groups">
        <field name="name">DeployFleet HR/Payroll Officer</field>
        <field name="privilege_id" ref="group_privilege_deployfleet_operations"/>
        <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>

    <record id="group_deployfleet_system_auditor" model="res.groups">
        <field name="name">DeployFleet System Auditor</field>
        <field name="privilege_id" ref="group_privilege_deployfleet_operations"/>
        <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>

    <!--
        Without this, a fresh install leaves the initial admin user in none
        of the groups above, so every DeployFleet menu (all gated by these
        groups) is invisible to the only user that exists - only menus
        gated by base.group_system (AI, Event Bus, Vehicle Types) show up.
        group_deployfleet_owner is the top of the implied_ids chain, so
        this also grants manager/dispatcher/driver access transitively.

        Deliberately a <function> call, not a <record id="base.user_admin">
        block: base.user_admin's ir.model.data entry is created by Odoo's
        own base module with noupdate="1" (protecting the admin user from
        being clobbered by every module upgrade), so a plain <record> here
        is silently skipped by the loader on every install/update, from the
        very first install onward - no error, nothing to notice, it just
        never applies. A <function> call is a direct method invocation, not
        a data-file record load, so it isn't subject to that noupdate flag
        at all and actually runs every time this module installs/updates.
    -->
    <function model="res.users" name="write"
              eval="[[ref('base.user_admin')], {'groups_id': [(4, ref('group_deployfleet_owner'))]}]"/>
</odoo>
