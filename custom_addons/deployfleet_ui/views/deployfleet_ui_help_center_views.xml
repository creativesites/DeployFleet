<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Help Center (doc 22) - own top-level menu item for now. Mega
        Menu/Launcher/Command Palette/contextual-button wiring is a
        separate batch (doc 22 §4) so this screen is reachable and
        click-testable on its own first. Placed at sequence 40, the
        next free slot after Compliance Override Ledger (39).
    -->
    <record id="action_deployfleet_help_center" model="ir.actions.client">
        <field name="name">Help Center</field>
        <field name="tag">deployfleet_ui.help_center</field>
    </record>

    <menuitem id="menu_deployfleet_help_center"
              name="Help Center"
              parent="deployfleet_core.menu_deployfleet_root"
              action="action_deployfleet_help_center"
              sequence="40"/>
</odoo>
