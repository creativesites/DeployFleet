<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="deployfleet_ui.FleetCommandCenter">
        <div class="df-fleet-cc">
            <header class="df-fleet-cc__header">
                <h1 class="df-fleet-cc__title">Fleet Command Center</h1>
                <p class="df-fleet-cc__subtitle">Which trucks are making money?</p>
            </header>

            <DeployfleetErrorBanner t-if="!state.loading and state.loadError" message="state.loadError"/>

            <section t-if="!state.loading" class="df-fleet-cc__filters">
                <DeployfleetStatusPill t-foreach="statusFilters" t-as="filter" t-key="filter.key"
                                       label="filter.label"
                                       count="filter.count"
                                       status="filter.key === state.statusFilter ? 'info' : 'success'"
                                       onClick="() => this.state.statusFilter = filter.key"/>
            </section>

            <p t-if="state.loading" class="df-fleet-cc__loading">Loading vehicles...</p>
            <p t-if="!state.loading and filteredVehicles.length === 0" class="df-fleet-cc__empty">
                No vehicles match this filter.
            </p>

            <div t-if="!state.loading" class="df-fleet-cc__list">
                <div t-foreach="filteredVehicles" t-as="vehicle" t-key="vehicle.id"
                     t-attf-class="df-fleet-cc__card df-fleet-cc__card--{{ vehicle.status }}">
                    <div class="df-fleet-cc__card-summary" t-on-click="() => this.onSelectVehicle(vehicle.id)">
                        <div class="df-fleet-cc__card-main">
                            <span class="df-fleet-cc__card-plate" t-esc="vehicle.license_plate or vehicle.name"/>
                            <span t-if="vehicle.current_driver_id" class="df-fleet-cc__card-driver">
                                <i class="fa fa-user"/> <t t-esc="vehicle.current_driver_id[1]"/>
                            </span>
                            <span t-if="vehicle.current_trip_id" class="df-fleet-cc__card-trip">
                                <i class="fa fa-road"/> <t t-esc="vehicle.current_trip_id[1]"/>
                            </span>
                        </div>
                        <div class="df-fleet-cc__card-meta">
                            <DeployfleetStatusBadge label="this.statusLabel(vehicle.status)" status="this.statusBadgeVariant(vehicle.status)"/>
                            <i t-attf-class="fa {{ state.selectedVehicleId === vehicle.id ? 'fa-chevron-up' : 'fa-chevron-down' }}"/>
                        </div>
                    </div>

                    <div t-if="state.selectedVehicleId === vehicle.id" class="df-fleet-cc__card-detail">
                        <t t-set="detail" t-value="state.detailByVehicleId[vehicle.id]"/>

                        <DeployfleetAiRecommendationCard
                            t-if="detail and detail.prediction"
                            title="this.predictionTitle(detail.prediction)"
                            body="detail.prediction.basis"
                            meta="this.predictionMeta(detail.prediction)"
                            actionLabel="'Open full record'"
                            onAction="() => this.onOpenVehicleForm(vehicle.id)"
                            onDismiss="() => this.onDismissPrediction(vehicle.id)"/>

                        <t t-set="edit" t-value="state.editByVehicleId[vehicle.id]"/>
                        <div t-if="edit" class="df-fleet-cc__detail-section">
                            <h3>Identity &amp; Capacity</h3>
                            <div class="df-fleet-cc__profile-form">
                                <input type="text" class="df-fleet-cc__profile-input" placeholder="License Plate"
                                       t-att-value="edit.license_plate"
                                       t-on-input="(ev) => this.onEditFieldInput(vehicle.id, 'license_plate', ev.target.value)"/>
                                <select class="df-fleet-cc__profile-select"
                                        t-att-value="edit.model_id"
                                        t-on-change="(ev) => this.onEditFieldInput(vehicle.id, 'model_id', ev.target.value)">
                                    <option value="">Model...</option>
                                    <option t-foreach="state.vehicleModels" t-as="model" t-key="model.id" t-att-value="model.id">
                                        <t t-esc="model.name"/>
                                    </option>
                                </select>
                                <select class="df-fleet-cc__profile-select"
                                        t-att-value="edit.vehicle_type_id"
                                        t-on-change="(ev) => this.onEditFieldInput(vehicle.id, 'vehicle_type_id', ev.target.value)">
                                    <option value="">Vehicle Type...</option>
                                    <option t-foreach="state.vehicleTypes" t-as="vtype" t-key="vtype.id" t-att-value="vtype.id">
                                        <t t-esc="vtype.name"/>
                                    </option>
                                </select>
                                <select class="df-fleet-cc__profile-select"
                                        t-att-value="edit.current_driver_id"
                                        t-on-change="(ev) => this.onEditFieldInput(vehicle.id, 'current_driver_id', ev.target.value)">
                                    <option value="">Current Driver...</option>
                                    <option t-foreach="state.driverOptions" t-as="driver" t-key="driver.id" t-att-value="driver.id">
                                        <t t-esc="driver.name"/>
                                    </option>
                                </select>
                                <input type="number" min="0" step="any" class="df-fleet-cc__profile-input" placeholder="Odometer"
                                       t-att-value="edit.odometer"
                                       t-on-input="(ev) => this.onEditFieldInput(vehicle.id, 'odometer', ev.target.value)"/>
                                <input type="number" min="0" step="any" class="df-fleet-cc__profile-input" placeholder="Max Weight (kg)"
                                       t-att-value="edit.max_weight_kg"
                                       t-on-input="(ev) => this.onEditFieldInput(vehicle.id, 'max_weight_kg', ev.target.value)"/>
                                <input type="number" min="0" step="any" class="df-fleet-cc__profile-input" placeholder="Max Volume (m3)"
                                       t-att-value="edit.max_volume_m3"
                                       t-on-input="(ev) => this.onEditFieldInput(vehicle.id, 'max_volume_m3', ev.target.value)"/>
                                <input type="number" min="0" step="any" class="df-fleet-cc__profile-input" placeholder="Gross Vehicle Weight (kg)"
                                       t-att-value="edit.gross_vehicle_weight_kg"
                                       t-on-input="(ev) => this.onEditFieldInput(vehicle.id, 'gross_vehicle_weight_kg', ev.target.value)"/>
                                <input type="number" min="0" step="any" class="df-fleet-cc__profile-input" placeholder="Tare Weight (kg)"
                                       t-att-value="edit.tare_weight_kg"
                                       t-on-input="(ev) => this.onEditFieldInput(vehicle.id, 'tare_weight_kg', ev.target.value)"/>
                                <span class="df-fleet-cc__profile-readonly">
                                    Payload capacity: <t t-esc="vehicle.payload_capacity_kg"/> kg
                                </span>
                                <DeployfleetButton
                                    label="'Save Profile'"
                                    variant="'primary'"
                                    loading="state.savingVehicleId === vehicle.id"
                                    onClick="() => this.onSaveVehicleProfile(vehicle.id)"/>
                            </div>
                        </div>

                        <div t-if="detail" class="df-fleet-cc__detail-section">
                            <h3>Current trip</h3>
                            <p t-if="!detail.trip" class="df-fleet-cc__muted">No active trip.</p>
                            <p t-if="detail.trip">
                                <t t-esc="detail.trip.name"/> — <t t-esc="detail.trip.state"/>
                                <t t-if="detail.trip.planned_arrival">
                                    , ETA <t t-esc="detail.trip.planned_arrival"/>
                                </t>
                            </p>
                        </div>

                        <div t-if="detail" class="df-fleet-cc__detail-section">
                            <h3>Compliance</h3>
                            <p t-if="detail.documents.length === 0" class="df-fleet-cc__muted">No documents on file.</p>
                            <ul t-if="detail.documents.length > 0" class="df-fleet-cc__detail-list">
                                <li t-foreach="detail.documents" t-as="document" t-key="document.id">
                                    <span t-esc="document.document_type_id[1]"/>
                                    <DeployfleetStatusBadge
                                        label="this.documentStateLabel(document.state)"
                                        status="document.state === 'expired' ? 'danger' : (document.state === 'expiring_soon' ? 'warning' : 'success')"/>
                                </li>
                            </ul>
                        </div>

                        <div t-if="detail" class="df-fleet-cc__detail-section">
                            <h3>Maintenance</h3>
                            <p t-if="detail.maintenanceSchedules.length === 0" class="df-fleet-cc__muted">No schedules configured.</p>
                            <ul t-if="detail.maintenanceSchedules.length > 0" class="df-fleet-cc__detail-list">
                                <li t-foreach="detail.maintenanceSchedules" t-as="schedule" t-key="schedule.id">
                                    <span t-esc="schedule.name"/>
                                    <DeployfleetStatusBadge t-if="schedule.is_due" label="'Due'" status="'warning'"/>
                                    <DeployfleetStatusBadge t-if="!schedule.is_due" label="'On schedule'" status="'success'"/>
                                </li>
                            </ul>
                        </div>

                        <div t-if="detail" class="df-fleet-cc__detail-section">
                            <h3>Recent fuel</h3>
                            <p t-if="detail.fuelLogs.length === 0" class="df-fleet-cc__muted">No fuel logs yet.</p>
                            <ul t-if="detail.fuelLogs.length > 0" class="df-fleet-cc__detail-list">
                                <li t-foreach="detail.fuelLogs" t-as="log" t-key="log.id">
                                    <span t-esc="log.date"/> — <t t-esc="log.liters"/> L
                                    <DeployfleetStatusBadge t-if="log.isAnomalous" label="this.fuelAnomalyLabel(log)" status="'danger'"/>
                                </li>
                            </ul>
                        </div>

                        <div t-if="detail" class="df-fleet-cc__detail-section">
                            <h3>Tyres</h3>
                            <p t-if="detail.tyres.length === 0" class="df-fleet-cc__muted">No tyres on file.</p>
                            <ul t-if="detail.tyres.length > 0" class="df-fleet-cc__detail-list">
                                <li t-foreach="detail.tyres" t-as="tyre" t-key="tyre.id">
                                    <span t-esc="this.tyrePositionLabel(tyre.position)"/>
                                    <span class="df-fleet-cc__tyre-tread"><t t-esc="tyre.tread_depth_mm"/> mm</span>
                                    <DeployfleetStatusBadge
                                        label="this.tyreStateLabel(tyre.state)"
                                        status="tyre.state === 'retreaded' ? 'warning' : 'success'"/>
                                </li>
                            </ul>
                        </div>

                        <div t-if="detail" class="df-fleet-cc__detail-section">
                            <h3>Insurance</h3>
                            <p t-if="!detail.insurance" class="df-fleet-cc__muted">No policy on file.</p>
                            <p t-if="detail.insurance" class="df-fleet-cc__insurance-line">
                                <span t-esc="detail.insurance.policy_number"/>
                                <t t-if="detail.insurance.insurer_id"> — <t t-esc="detail.insurance.insurer_id[1]"/></t>
                                , expires <t t-esc="detail.insurance.end_date"/>
                                <DeployfleetStatusBadge
                                    t-if="detail.insurance.openClaimsCount > 0"
                                    label="detail.insurance.openClaimsCount + ' open claim(s)'"
                                    status="'warning'"/>
                            </p>
                        </div>

                        <div t-if="detail" class="df-fleet-cc__detail-section">
                            <h3>Workshop</h3>
                            <p t-if="detail.jobCards.length === 0" class="df-fleet-cc__muted">No open job cards.</p>
                            <ul t-if="detail.jobCards.length > 0" class="df-fleet-cc__detail-list">
                                <li t-foreach="detail.jobCards" t-as="jobCard" t-key="jobCard.id">
                                    <span t-esc="jobCard.name"/>
                                    <span class="df-fleet-cc__card-cost"><t t-esc="jobCard.total_cost"/></span>
                                    <DeployfleetStatusBadge
                                        label="this.jobCardStateLabel(jobCard.state)"
                                        status="this.jobCardStateBadgeVariant(jobCard.state)"/>
                                </li>
                            </ul>
                        </div>

                        <div class="df-fleet-cc__detail-actions">
                            <DeployfleetButton
                                t-if="vehicle.status !== 'available'"
                                label="'Mark Available'"
                                variant="'primary'"
                                loading="state.transitioningVehicleId === vehicle.id"
                                onClick="() => this.onSetStatus(vehicle.id, 'action_set_available')"/>
                            <DeployfleetButton
                                t-if="vehicle.status !== 'maintenance'"
                                label="'Send to Maintenance'"
                                variant="'secondary'"
                                loading="state.transitioningVehicleId === vehicle.id"
                                onClick="() => this.onSetStatus(vehicle.id, 'action_set_maintenance')"/>
                            <DeployfleetButton
                                t-if="vehicle.status !== 'breakdown'"
                                label="'Report Breakdown'"
                                variant="'destructive'"
                                loading="state.transitioningVehicleId === vehicle.id"
                                onClick="() => this.onSetStatus(vehicle.id, 'action_set_breakdown')"/>
                            <DeployfleetButton
                                label="'Open full record'"
                                variant="'ghost'"
                                onClick="() => this.onOpenVehicleForm(vehicle.id)"/>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
