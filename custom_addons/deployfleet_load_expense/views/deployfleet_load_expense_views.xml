<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_deployfleet_load_expense_form" model="ir.ui.view">
        <field name="name">deployfleet.load.expense.form</field>
        <field name="model">deployfleet.load.expense</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="shipment_id"/>
                        <field name="trip_id"/>
                        <field name="expense_type"/>
                        <field name="amount"/>
                        <field name="currency_id" groups="base.group_multi_currency"/>
                        <field name="recorded_by"/>
                        <field name="receipt" widget="image"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_deployfleet_load_expense_list" model="ir.ui.view">
        <field name="name">deployfleet.load.expense.list</field>
        <field name="model">deployfleet.load.expense</field>
        <field name="arch" type="xml">
            <list>
                <field name="shipment_id"/>
                <field name="trip_id"/>
                <field name="expense_type"/>
                <field name="amount"/>
                <field name="recorded_by"/>
            </list>
        </field>
    </record>

    <record id="action_deployfleet_load_expense" model="ir.actions.act_window">
        <field name="name">Load Expenses</field>
        <field name="res_model">deployfleet.load.expense</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_deployfleet_load_expense"
              name="Load Expenses"
              parent="deployfleet_core.menu_deployfleet_root"
              action="action_deployfleet_load_expense"
              groups="deployfleet_security.group_deployfleet_dispatcher"
              sequence="65"/>
</odoo>
