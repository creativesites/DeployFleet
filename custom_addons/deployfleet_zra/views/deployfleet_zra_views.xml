<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_deployfleet_zra_config_form" model="ir.ui.view">
        <field name="name">deployfleet.zra.config.form</field>
        <field name="model">deployfleet.zra.config</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_initialize_device" type="object" string="Initialize Device"
                            invisible="initialized" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="environment"/>
                            <field name="base_url"/>
                            <field name="initialized" readonly="1"/>
                        </group>
                        <group>
                            <field name="tpin"/>
                            <field name="branch_id"/>
                            <field name="device_serial_no"/>
                            <field name="default_vat_category_code"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_deployfleet_zra_config" model="ir.actions.act_window">
        <field name="name">ZRA Device Configuration</field>
        <field name="res_model">deployfleet.zra.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_deployfleet_zra_submission_form" model="ir.ui.view">
        <field name="name">deployfleet.zra.submission.form</field>
        <field name="model">deployfleet.zra.submission</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Retry Submission"
                            invisible="state == 'accepted'" class="oe_highlight"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="invoice_id"/>
                        <field name="zra_receipt_no"/>
                        <field name="submitted_date"/>
                        <field name="error_message" invisible="state != 'error'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_deployfleet_zra_submission_list" model="ir.ui.view">
        <field name="name">deployfleet.zra.submission.list</field>
        <field name="model">deployfleet.zra.submission</field>
        <field name="arch" type="xml">
            <list>
                <field name="invoice_id"/>
                <field name="state"/>
                <field name="zra_receipt_no"/>
                <field name="submitted_date"/>
            </list>
        </field>
    </record>

    <record id="action_deployfleet_zra_submission" model="ir.actions.act_window">
        <field name="name">ZRA Submissions</field>
        <field name="res_model">deployfleet.zra.submission</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_deployfleet_zra_root"
              name="ZRA Smart Invoice"
              parent="deployfleet_billing.menu_deployfleet_billing_root"
              groups="deployfleet_security.group_deployfleet_manager"
              sequence="30"/>
    <menuitem id="menu_deployfleet_zra_submission"
              name="Submissions"
              parent="menu_deployfleet_zra_root"
              action="action_deployfleet_zra_submission"
              sequence="10"/>
    <menuitem id="menu_deployfleet_zra_config"
              name="Device Configuration"
              parent="menu_deployfleet_zra_root"
              action="action_deployfleet_zra_config"
              groups="deployfleet_security.group_deployfleet_owner"
              sequence="20"/>
</odoo>
