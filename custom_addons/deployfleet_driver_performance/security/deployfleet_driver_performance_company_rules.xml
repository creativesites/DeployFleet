<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Engineering-audit fix (C-01): deployfleet.driver.performance.
        event had no company_id field, or any ir.rule, at all. driver_id
        (required) already carries hr.employee's own native company_id,
        so it's scoped via a relational domain instead of a redundant
        column.
    -->
    <record id="deployfleet_driver_performance_event_rule_company" model="ir.rule">
        <field name="name">Driver Performance Event: multi-company</field>
        <field name="model_id" ref="model_deployfleet_driver_performance_event"/>
        <field name="domain_force">[('driver_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
