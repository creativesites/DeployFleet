<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Record rule for the driver self-service fix (Driver & HR
        domain audit, docs/architecture/20-experience-implementation-strategy.md):
        deployfleet.leave.request previously granted the driver group
        perm_create=1 but perm_write=0 — meaning a driver could file a
        leave request but could never call action_submit() on it
        themselves (it writes), and the model-wide ACL alone would let
        any driver read/create/write against *any* employee's leave
        requests, not just their own, once write access was granted.

        This is the first ir.rule in the DeployFleet codebase. Scopes
        the driver group (now perm_read=1/perm_write=1/perm_create=1 in
        ir.model.access.csv) to their own employee's requests only, via
        the standard Odoo self-service pattern (hr.employee.user_id).
    -->
    <record id="deployfleet_leave_request_rule_driver_own" model="ir.rule">
        <field name="name">Driver: own leave requests only</field>
        <field name="model_id" ref="model_deployfleet_leave_request"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('deployfleet_security.group_deployfleet_driver'))]"/>
    </record>

    <!--
        Bug found in the DeployFleet engineering audit: the rule above
        was the model's ONLY rule, and group_deployfleet_manager implies
        group_deployfleet_dispatcher implies group_deployfleet_driver
        (deployfleet_security/security/deployfleet_security_groups.xml)
        — so every dispatcher/manager/owner is also, transitively, a
        member of the driver group. Odoo ORs a user's applicable
        group-scoped rules, but since the driver-own rule was the only
        one defined, every dispatcher/manager/owner got restricted to
        their own employee record too (almost always none, since they
        aren't drivers) — nobody but the requester could ever see or
        approve a leave request. The comment previously here claiming
        "dispatcher/manager/owner remain unrestricted" was incorrect.

        This second rule grants the dispatcher group (and everything
        that implies it) unrestricted company-wide access; ORed against
        the driver-own rule above, a dispatcher/manager/owner user's
        effective access is the union of both — i.e. unrestricted,
        while a plain driver (not in the dispatcher group) still only
        matches the first rule.
    -->
    <record id="deployfleet_leave_request_rule_dispatcher_all" model="ir.rule">
        <field name="name">Dispatcher/Manager/Owner: all leave requests</field>
        <field name="model_id" ref="model_deployfleet_leave_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('deployfleet_security.group_deployfleet_dispatcher'))]"/>
    </record>
</odoo>
