<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_deployfleet_ai_action_request_form" model="ir.ui.view">
        <field name="name">deployfleet.ai.action.request.form</field>
        <field name="model">deployfleet.ai.action.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit_for_approval" type="object" string="Submit for Approval"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="oe_highlight"
                            invisible="state != 'pending_approval'"
                            groups="deployfleet_security.group_deployfleet_manager"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'pending_approval'"
                            groups="deployfleet_security.group_deployfleet_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="feature_id"/>
                            <field name="action_type"/>
                            <field name="target_model"/>
                            <field name="target_id"/>
                            <field name="source_context"/>
                        </group>
                        <group>
                            <field name="requested_by" readonly="1"/>
                            <field name="approved_by" readonly="1"/>
                            <field name="executed_at" readonly="1"/>
                            <field name="result_record_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="What This Action Would Write">
                        <field name="proposed_vals" nolabel="1" widget="text"/>
                    </group>
                    <group string="Rejection Reason" invisible="state != 'rejected'">
                        <field name="rejection_reason" nolabel="1"/>
                    </group>
                    <group string="Error" invisible="state != 'failed'">
                        <field name="error_message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_deployfleet_ai_action_request_list" model="ir.ui.view">
        <field name="name">deployfleet.ai.action.request.list</field>
        <field name="model">deployfleet.ai.action.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="feature_id"/>
                <field name="action_type"/>
                <field name="target_model"/>
                <field name="requested_by"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_deployfleet_ai_action_request" model="ir.actions.act_window">
        <field name="name">AI Action Requests</field>
        <field name="res_model">deployfleet.ai.action.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_deployfleet_ai_action_request"
              name="Action Requests"
              parent="deployfleet_ai_core.menu_deployfleet_ai_root"
              action="action_deployfleet_ai_action_request"
              groups="deployfleet_security.group_deployfleet_dispatcher"
              sequence="70"/>
</odoo>
