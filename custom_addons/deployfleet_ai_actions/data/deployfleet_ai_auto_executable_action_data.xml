<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- doc 21 §4's concrete starting allow-list (docs/architecture/
         21-copilot-rail-architecture.md): deliberately one entry to
         start, not the full 3-item sketch - action_confirm() is only
         safe "when no override is needed" (a condition this allow-list
         mechanism can't express on its own, since it's a runtime property
         of the specific call, not a static {model, method} pair), and no
         workshop job-card status-advance method is stock-consumption-free
         enough yet to add without a closer look. Both are real follow-ups,
         not silently dropped. -->
    <record id="auto_exec_mark_vehicle_available" model="deployfleet.ai.auto.executable.action">
        <field name="action_type">mark_vehicle_available</field>
        <field name="target_model">deployfleet.vehicle</field>
        <field name="action_method">action_set_available</field>
        <field name="auto_execute">True</field>
        <field name="description">Marking an available vehicle available again is idempotent and trivially reversible (any other status button undoes it); the vehicle's own state machine, not this allow-list, is what actually gates whether the call has any effect.</field>
    </record>
</odoo>
