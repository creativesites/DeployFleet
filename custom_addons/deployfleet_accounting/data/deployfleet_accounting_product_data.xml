<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Every deployfleet.invoice line posts against this one service
        product, purely so account.move can derive an income account from
        its product category - DeployFleet invoice lines aren't sold as
        products in Odoo's normal sales-order sense, this is invoicing
        plumbing, not a catalog entry.
    -->
    <record id="product_deployfleet_freight_service" model="product.product">
        <field name="name">Freight Transport Service</field>
        <field name="type">service</field>
        <field name="sale_ok">false</field>
        <field name="purchase_ok">false</field>
    </record>
</odoo>
