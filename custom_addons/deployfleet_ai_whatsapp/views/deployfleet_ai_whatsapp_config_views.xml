<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_deployfleet_ai_whatsapp_config_form" model="ir.ui.view">
        <field name="name">deployfleet.ai.whatsapp.config.form</field>
        <field name="model">deployfleet.ai.whatsapp.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="phone_number_id"/>
                        <field name="access_token" password="True"/>
                        <field name="webhook_verify_token" password="True"/>
                        <field name="enabled"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_deployfleet_ai_whatsapp_config" model="ir.actions.act_window">
        <field name="name">WhatsApp Configuration</field>
        <field name="res_model">deployfleet.ai.whatsapp.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_deployfleet_ai_whatsapp_config"
              name="WhatsApp"
              parent="deployfleet_ai_core.menu_deployfleet_ai_root"
              action="action_deployfleet_ai_whatsapp_config"
              groups="deployfleet_security.group_deployfleet_owner"
              sequence="65"/>
</odoo>
