<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_deployfleet_shipment_form" model="ir.ui.view">
        <field name="name">deployfleet.shipment.form</field>
        <field name="model">deployfleet.shipment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_suggest_assignments" type="object" string="Suggest Assignments"
                            invisible="state not in ('confirmed',)"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('cancelled', 'delivered')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,assigned,in_transit,delivered"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Customer">
                            <field name="customer_id"/>
                            <field name="contract_id" domain="[('customer_id', '=', customer_id)]"/>
                            <field name="company_id"/>
                        </group>
                        <group string="Cargo">
                            <field name="cargo_description"/>
                            <field name="weight_kg"/>
                            <field name="required_vehicle_type_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Route">
                            <field name="pickup_depot_id"/>
                            <field name="dropoff_depot_id"/>
                            <field name="requested_pickup_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Dispatch Assignments">
                            <field name="assignment_ids">
                                <list decoration-success="state == 'confirmed'" decoration-muted="state == 'cancelled'">
                                    <field name="vehicle_id"/>
                                    <field name="driver_id"/>
                                    <field name="score"/>
                                    <field name="state" widget="badge"/>
                                    <field name="override_reason"/>
                                    <button name="action_confirm" type="object" string="Confirm"
                                            invisible="state != 'proposed'"/>
                                    <button name="action_cancel" type="object" string="Cancel"
                                            invisible="state not in ('proposed', 'confirmed')"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_deployfleet_shipment_list" model="ir.ui.view">
        <field name="name">deployfleet.shipment.list</field>
        <field name="model">deployfleet.shipment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="pickup_depot_id"/>
                <field name="dropoff_depot_id"/>
                <field name="requested_pickup_date"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('assigned', 'delivered')"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_deployfleet_shipment_kanban" model="ir.ui.view">
        <field name="name">deployfleet.shipment.kanban</field>
        <field name="model">deployfleet.shipment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <templates>
                    <t t-name="card">
                        <field name="name"/>
                        <div><field name="customer_id"/></div>
                        <div>
                            <field name="pickup_depot_id"/> -> <field name="dropoff_depot_id"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_deployfleet_shipment" model="ir.actions.act_window">
        <field name="name">Shipments</field>
        <field name="res_model">deployfleet.shipment</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <menuitem id="menu_deployfleet_shipment"
              name="Shipments"
              parent="deployfleet_core.menu_deployfleet_root"
              action="action_deployfleet_shipment"
              groups="deployfleet_security.group_deployfleet_dispatcher"
              sequence="5"/>
</odoo>
