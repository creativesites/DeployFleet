<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Engineering-audit fix (C-01): neither model had a company_id
        field, or any ir.rule, at all - payroll data is squarely the
        kind of thing that must never leak across companies.
        employee_id (required) already carries hr.employee's own native
        company_id, so deployfleet.payroll.payslip is scoped via a
        relational domain instead of a redundant column; .payslip.line
        is a required, ondelete-cascade child of payslip_id, scoped the
        same way one hop further out.
    -->
    <record id="deployfleet_payroll_payslip_rule_company" model="ir.rule">
        <field name="name">Payslip: multi-company</field>
        <field name="model_id" ref="model_deployfleet_payroll_payslip"/>
        <field name="domain_force">[('employee_id.company_id', 'in', company_ids)]</field>
    </record>

    <record id="deployfleet_payroll_payslip_line_rule_company" model="ir.rule">
        <field name="name">Payslip Line: multi-company</field>
        <field name="model_id" ref="model_deployfleet_payroll_payslip_line"/>
        <field name="domain_force">[('payslip_id.employee_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
