<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Engineering-audit fix (C-01): none of these three models had a
        company_id field, or any ir.rule, at all.

        deployfleet.tyre gets its own company_id column (added alongside
        this file) since it's the top-level record. Its two child models
        (deployfleet.tyre.event/.tyre.reading, both required, ondelete
        cascade tyre_id) are scoped via a relational domain against their
        parent instead of a redundant company_id column of their own -
        a child record's company can never legitimately differ from its
        parent tyre's.
    -->
    <record id="deployfleet_tyre_rule_company" model="ir.rule">
        <field name="name">Tyre: multi-company</field>
        <field name="model_id" ref="model_deployfleet_tyre"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="deployfleet_tyre_event_rule_company" model="ir.rule">
        <field name="name">Tyre Event: multi-company</field>
        <field name="model_id" ref="model_deployfleet_tyre_event"/>
        <field name="domain_force">[('tyre_id.company_id', 'in', company_ids)]</field>
    </record>

    <record id="deployfleet_tyre_reading_rule_company" model="ir.rule">
        <field name="name">Tyre Reading: multi-company</field>
        <field name="model_id" ref="model_deployfleet_tyre_reading"/>
        <field name="domain_force">[('tyre_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
