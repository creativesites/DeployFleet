<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_deployfleet_vehicle_type_list" model="ir.ui.view">
        <field name="name">deployfleet.vehicle.type.list</field>
        <field name="model">deployfleet.vehicle.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>
    <record id="action_deployfleet_vehicle_type" model="ir.actions.act_window">
        <field name="name">Vehicle Types</field>
        <field name="res_model">deployfleet.vehicle.type</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem id="menu_deployfleet_vehicle_type"
              name="Vehicle Types"
              parent="menu_deployfleet_root"
              action="action_deployfleet_vehicle_type"
              groups="base.group_system"
              sequence="200"/>
</odoo>
