<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_deployfleet_delivery_form" model="ir.ui.view">
        <field name="name">deployfleet.delivery.form</field>
        <field name="model">deployfleet.delivery</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="trip_id"/>
                            <field name="shipment_id" domain="[('id', 'in', trip_id.shipment_line_ids.shipment_id.ids)]"/>
                            <field name="delivered_at"/>
                        </group>
                        <group>
                            <field name="recipient_name"/>
                            <field name="gps_stamp"/>
                        </group>
                    </group>
                    <group>
                        <field name="signature" widget="image"/>
                        <field name="photo" widget="image"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_deployfleet_delivery_list" model="ir.ui.view">
        <field name="name">deployfleet.delivery.list</field>
        <field name="model">deployfleet.delivery</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="shipment_id"/>
                <field name="trip_id"/>
                <field name="delivered_at"/>
                <field name="recipient_name"/>
            </list>
        </field>
    </record>

    <record id="action_deployfleet_delivery" model="ir.actions.act_window">
        <field name="name">Deliveries</field>
        <field name="res_model">deployfleet.delivery</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_deployfleet_delivery"
              name="Deliveries"
              parent="deployfleet_core.menu_deployfleet_root"
              action="action_deployfleet_delivery"
              groups="deployfleet_security.group_deployfleet_dispatcher"
              sequence="8"/>
</odoo>
