<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_deployfleet_help_article_form" model="ir.ui.view">
        <field name="name">deployfleet.help.article.form</field>
        <field name="model">deployfleet.help.article</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="slug"/>
                            <field name="category_id"/>
                            <field name="content_type"/>
                            <field name="summary"/>
                        </group>
                        <group>
                            <field name="tag_ids" widget="many2many_tags"/>
                            <field name="related_article_ids" widget="many2many_tags"/>
                            <field name="related_workflow_id"/>
                            <field name="role_group_ids" widget="many2many_tags"/>
                            <field name="context_key"/>
                            <field name="sequence"/>
                            <field name="view_count" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="body" widget="html"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_deployfleet_help_article_list" model="ir.ui.view">
        <field name="name">deployfleet.help.article.list</field>
        <field name="model">deployfleet.help.article</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="content_type"/>
                <field name="view_count"/>
            </list>
        </field>
    </record>

    <record id="action_deployfleet_help_article" model="ir.actions.act_window">
        <field name="name">Help Articles</field>
        <field name="res_model">deployfleet.help.article</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_deployfleet_help_article"
              name="Help Articles"
              parent="deployfleet_core.menu_deployfleet_root"
              action="action_deployfleet_help_article"
              groups="deployfleet_security.group_deployfleet_manager"
              sequence="60"/>
</odoo>
