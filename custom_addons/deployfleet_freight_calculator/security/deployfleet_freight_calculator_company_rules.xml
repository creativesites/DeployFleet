<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Engineering-audit fix (C-01): deployfleet.calculation.parameter has
        a real company_id field but no ir.rule ever protected it.
    -->
    <record id="deployfleet_calculation_parameter_rule_company" model="ir.rule">
        <field name="name">Calculation Parameter: multi-company</field>
        <field name="model_id" ref="model_deployfleet_calculation_parameter"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
