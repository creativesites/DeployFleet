<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_deployfleet_calculation_rule_form" model="ir.ui.view">
        <field name="name">deployfleet.calculation.rule.form</field>
        <field name="model">deployfleet.calculation.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="key"/>
                        <field name="name"/>
                        <field name="formula"/>
                    </group>
                    <field name="variable_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="source"/>
                            <field name="parameter_key"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_deployfleet_calculation_rule_list" model="ir.ui.view">
        <field name="name">deployfleet.calculation.rule.list</field>
        <field name="model">deployfleet.calculation.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="key"/>
                <field name="name"/>
                <field name="formula"/>
            </list>
        </field>
    </record>

    <record id="action_deployfleet_calculation_rule" model="ir.actions.act_window">
        <field name="name">Calculation Rules</field>
        <field name="res_model">deployfleet.calculation.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_deployfleet_calculation_parameter_list" model="ir.ui.view">
        <field name="name">deployfleet.calculation.parameter.list</field>
        <field name="model">deployfleet.calculation.parameter</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="key"/>
                <field name="name"/>
                <field name="value"/>
                <field name="vehicle_type_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_deployfleet_calculation_parameter" model="ir.actions.act_window">
        <field name="name">Calculation Parameters</field>
        <field name="res_model">deployfleet.calculation.parameter</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_deployfleet_calculator_root"
              name="Freight Calculator"
              parent="deployfleet_core.menu_deployfleet_root"
              groups="deployfleet_security.group_deployfleet_dispatcher"
              sequence="60"/>
    <menuitem id="menu_deployfleet_calculation_rule"
              name="Calculation Rules"
              parent="menu_deployfleet_calculator_root"
              action="action_deployfleet_calculation_rule"
              groups="deployfleet_security.group_deployfleet_manager"
              sequence="10"/>
    <menuitem id="menu_deployfleet_calculation_parameter"
              name="Calculation Parameters"
              parent="menu_deployfleet_calculator_root"
              action="action_deployfleet_calculation_parameter"
              groups="deployfleet_security.group_deployfleet_manager"
              sequence="20"/>
</odoo>
