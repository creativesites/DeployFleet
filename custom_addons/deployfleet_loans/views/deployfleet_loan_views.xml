<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_deployfleet_loan_form" model="ir.ui.view">
        <field name="name">deployfleet.loan.form</field>
        <field name="model">deployfleet.loan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="active,closed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="start_date"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="monthly_deduction"/>
                            <field name="outstanding_balance"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_deployfleet_loan_list" model="ir.ui.view">
        <field name="name">deployfleet.loan.list</field>
        <field name="model">deployfleet.loan</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="amount"/>
                <field name="monthly_deduction"/>
                <field name="outstanding_balance"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'" decoration-muted="state == 'closed'"/>
            </list>
        </field>
    </record>

    <record id="action_deployfleet_loan" model="ir.actions.act_window">
        <field name="name">Loans</field>
        <field name="res_model">deployfleet.loan</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_deployfleet_loan"
              name="Loans"
              parent="deployfleet_payroll.menu_deployfleet_payroll_root"
              action="action_deployfleet_loan"
              sequence="30"/>
</odoo>
