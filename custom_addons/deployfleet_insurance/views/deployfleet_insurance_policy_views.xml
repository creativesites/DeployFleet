<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_deployfleet_insurance_policy_form" model="ir.ui.view">
        <field name="name">deployfleet.insurance.policy.form</field>
        <field name="model">deployfleet.insurance.policy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="vehicle_id"/>
                            <field name="policy_number"/>
                            <field name="insurer_id"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="premium_amount"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Claims">
                            <field name="claim_ids">
                                <list>
                                    <field name="claim_number"/>
                                    <field name="incident_date"/>
                                    <field name="amount_claimed"/>
                                    <field name="amount_approved"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_deployfleet_insurance_policy_list" model="ir.ui.view">
        <field name="name">deployfleet.insurance.policy.list</field>
        <field name="model">deployfleet.insurance.policy</field>
        <field name="arch" type="xml">
            <list>
                <field name="vehicle_id"/>
                <field name="policy_number"/>
                <field name="insurer_id"/>
                <field name="end_date"/>
                <field name="premium_amount"/>
            </list>
        </field>
    </record>

    <record id="action_deployfleet_insurance_policy" model="ir.actions.act_window">
        <field name="name">Insurance Policies</field>
        <field name="res_model">deployfleet.insurance.policy</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_deployfleet_insurance_policy"
              name="Insurance"
              parent="deployfleet_core.menu_deployfleet_root"
              action="action_deployfleet_insurance_policy"
              groups="deployfleet_security.group_deployfleet_dispatcher"
              sequence="57"/>
</odoo>
