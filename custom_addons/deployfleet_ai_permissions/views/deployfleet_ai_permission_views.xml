<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_deployfleet_ai_permission_list" model="ir.ui.view">
        <field name="name">deployfleet.ai.permission.list</field>
        <field name="model">deployfleet.ai.permission</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="feature_id"/>
                <field name="group_id"/>
            </list>
        </field>
    </record>

    <record id="action_deployfleet_ai_permission" model="ir.actions.act_window">
        <field name="name">AI Feature Permissions</field>
        <field name="res_model">deployfleet.ai.permission</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_deployfleet_ai_permission"
              name="Permissions"
              parent="deployfleet_ai_core.menu_deployfleet_ai_root"
              action="action_deployfleet_ai_permission"
              groups="deployfleet_security.group_deployfleet_owner"
              sequence="60"/>
</odoo>
