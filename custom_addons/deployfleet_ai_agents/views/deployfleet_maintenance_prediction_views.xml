<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_deployfleet_maintenance_prediction_list" model="ir.ui.view">
        <field name="name">deployfleet.maintenance.prediction.list</field>
        <field name="model">deployfleet.maintenance.prediction</field>
        <field name="arch" type="xml">
            <list decoration-danger="risk_level == 'high'" decoration-warning="risk_level == 'medium'">
                <field name="vehicle_id"/>
                <field name="risk_score"/>
                <field name="risk_level"/>
                <field name="recent_job_card_count"/>
                <field name="computed_date"/>
            </list>
        </field>
    </record>

    <record id="view_deployfleet_maintenance_prediction_form" model="ir.ui.view">
        <field name="name">deployfleet.maintenance.prediction.form</field>
        <field name="model">deployfleet.maintenance.prediction</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="vehicle_id"/>
                        <field name="risk_score"/>
                        <field name="risk_level"/>
                        <field name="consumption_trend_slope"/>
                        <field name="recent_job_card_count"/>
                        <field name="computed_date"/>
                    </group>
                    <group string="Basis">
                        <field name="basis" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_deployfleet_maintenance_prediction" model="ir.actions.act_window">
        <field name="name">Predictive Maintenance</field>
        <field name="res_model">deployfleet.maintenance.prediction</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_deployfleet_maintenance_prediction"
              name="Predictive Maintenance"
              parent="deployfleet_ai_core.menu_deployfleet_ai_root"
              action="action_deployfleet_maintenance_prediction"
              groups="deployfleet_security.group_deployfleet_dispatcher"
              sequence="15"/>
</odoo>
