<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_deployfleet_financial_forecast_list" model="ir.ui.view">
        <field name="name">deployfleet.financial.forecast.list</field>
        <field name="model">deployfleet.financial.forecast</field>
        <field name="arch" type="xml">
            <list>
                <field name="computed_date"/>
                <field name="months_of_history"/>
                <field name="forecast_revenue"/>
                <field name="forecast_fuel_cost"/>
            </list>
        </field>
    </record>

    <record id="view_deployfleet_financial_forecast_form" model="ir.ui.view">
        <field name="name">deployfleet.financial.forecast.form</field>
        <field name="model">deployfleet.financial.forecast</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="computed_date"/>
                        <field name="months_of_history"/>
                        <field name="forecast_revenue"/>
                        <field name="forecast_fuel_cost"/>
                    </group>
                    <group string="Basis">
                        <field name="basis" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_deployfleet_financial_forecast" model="ir.actions.act_window">
        <field name="name">Financial Forecast</field>
        <field name="res_model">deployfleet.financial.forecast</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_deployfleet_financial_forecast"
              name="Financial Forecast"
              parent="deployfleet_ai_core.menu_deployfleet_ai_root"
              action="action_deployfleet_financial_forecast"
              groups="deployfleet_security.group_deployfleet_manager"
              sequence="17"/>
</odoo>
