<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_deployfleet_maintenance_prediction" model="ir.cron">
        <field name="name">DeployFleet: compute predictive maintenance scores</field>
        <field name="model_id" ref="model_deployfleet_maintenance_prediction"/>
        <field name="state">code</field>
        <field name="code">model._cron_compute_all()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_deployfleet_fuel_anomaly" model="ir.cron">
        <field name="name">DeployFleet: detect statistical fuel anomalies</field>
        <field name="model_id" ref="model_deployfleet_fuel_anomaly"/>
        <field name="state">code</field>
        <field name="code">model._cron_detect_for_all_vehicles()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_deployfleet_financial_forecast" model="ir.cron">
        <field name="name">DeployFleet: compute financial forecast</field>
        <field name="model_id" ref="model_deployfleet_financial_forecast"/>
        <field name="state">code</field>
        <field name="code">model._cron_compute_all_companies()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="active">True</field>
    </record>
</odoo>
