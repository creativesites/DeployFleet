<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Policy -->
    <record id="view_deployfleet_ai_policy_form" model="ir.ui.view">
        <field name="name">deployfleet.ai.policy.form</field>
        <field name="model">deployfleet.ai.policy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="company_id"/>
                        <field name="ai_enabled"/>
                        <field name="external_providers_allowed"/>
                    </group>
                    <group string="Data Category Policy">
                        <field name="block_payroll_data"/>
                        <field name="block_financial_data"/>
                        <field name="block_fleet_analytics"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_deployfleet_ai_policy" model="ir.actions.act_window">
        <field name="name">AI Policy</field>
        <field name="res_model">deployfleet.ai.policy</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Config -->
    <record id="view_deployfleet_ai_config_form" model="ir.ui.view">
        <field name="name">deployfleet.ai.config.form</field>
        <field name="model">deployfleet.ai.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="company_id"/>
                        <field name="active_provider"/>
                        <field name="fallback_provider"/>
                        <field name="max_tokens"/>
                        <field name="temperature"/>
                    </group>
                    <notebook>
                        <page string="DeepSeek">
                            <group>
                                <field name="deepseek_api_key" password="True"/>
                                <field name="deepseek_model_cheap"/>
                                <field name="deepseek_model_reasoning"/>
                            </group>
                        </page>
                        <page string="OpenAI">
                            <group>
                                <field name="openai_api_key" password="True"/>
                                <field name="openai_model_cheap"/>
                                <field name="openai_model_reasoning"/>
                            </group>
                        </page>
                        <page string="Claude">
                            <group>
                                <field name="claude_api_key" password="True"/>
                                <field name="claude_model_cheap"/>
                                <field name="claude_model_reasoning"/>
                            </group>
                        </page>
                        <page string="Gemini">
                            <group>
                                <field name="gemini_api_key" password="True"/>
                                <field name="gemini_model_cheap"/>
                                <field name="gemini_model_reasoning"/>
                            </group>
                        </page>
                        <page string="Caching">
                            <group>
                                <field name="enable_response_cache"/>
                                <field name="response_cache_ttl_hours"/>
                                <field name="enable_context_cache"/>
                                <field name="context_cache_ttl_hours"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_deployfleet_ai_config" model="ir.actions.act_window">
        <field name="name">AI Configuration</field>
        <field name="res_model">deployfleet.ai.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Feature toggles -->
    <record id="view_deployfleet_ai_feature_list" model="ir.ui.view">
        <field name="name">deployfleet.ai.feature.list</field>
        <field name="model">deployfleet.ai.feature</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="key"/>
                <field name="name"/>
                <field name="data_category"/>
                <field name="model_tier"/>
                <field name="provider_override"/>
                <field name="enabled"/>
            </list>
        </field>
    </record>
    <record id="action_deployfleet_ai_feature" model="ir.actions.act_window">
        <field name="name">AI Features</field>
        <field name="res_model">deployfleet.ai.feature</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Usage log -->
    <record id="view_deployfleet_ai_usage_list" model="ir.ui.view">
        <field name="name">deployfleet.ai.usage.list</field>
        <field name="model">deployfleet.ai.usage</field>
        <field name="arch" type="xml">
            <list default_order="call_date desc">
                <field name="call_date"/>
                <field name="feature"/>
                <field name="provider"/>
                <field name="model_name"/>
                <field name="tokens_in"/>
                <field name="tokens_out"/>
                <field name="estimated_cost_usd" sum="Total Cost"/>
                <field name="cache_hit"/>
                <field name="state" widget="badge" decoration-danger="state == 'error'"/>
            </list>
        </field>
    </record>
    <record id="action_deployfleet_ai_usage" model="ir.actions.act_window">
        <field name="name">AI Usage Log</field>
        <field name="res_model">deployfleet.ai.usage</field>
        <field name="view_mode">list,pivot</field>
    </record>

    <!-- Budget -->
    <record id="view_deployfleet_ai_budget_form" model="ir.ui.view">
        <field name="name">deployfleet.ai.budget.form</field>
        <field name="model">deployfleet.ai.budget</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="company_id"/>
                        <field name="monthly_token_limit"/>
                        <field name="monthly_cost_limit_usd"/>
                        <field name="alert_threshold_pct"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_deployfleet_ai_budget" model="ir.actions.act_window">
        <field name="name">AI Budget</field>
        <field name="res_model">deployfleet.ai.budget</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Company Profile (doc 21 §6) -->
    <record id="view_deployfleet_ai_company_profile_form" model="ir.ui.view">
        <field name="name">deployfleet.ai.company.profile.form</field>
        <field name="model">deployfleet.ai.company.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="company_id"/>
                        <field name="updated_date" readonly="1"/>
                    </group>
                    <group string="Profile">
                        <field name="profile_text" nolabel="1" placeholder="Fleet size, operating regions, business-rule notes the Copilot should already know without being told every conversation..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_deployfleet_ai_company_profile" model="ir.actions.act_window">
        <field name="name">AI Company Profile</field>
        <field name="res_model">deployfleet.ai.company.profile</field>
        <field name="view_mode">list,form</field>
    </record>

    <!--
        Deliberately no `groups` restriction on the root itself, matching
        deployfleet_core.menu_deployfleet_root's own unrestricted pattern
        (that root has none either — see deployfleet_menus.xml's own
        comment). This used to be `groups="base.group_system"`, which
        hid every AI submenu from every DeployFleet role (owner/manager/
        dispatcher never imply base.group_system), including submenus
        that had their own, more permissive `groups` attribute — an
        ancestor gate silently overrides a child's own visibility rule.
        True admin-only screens (Policy/Configuration/Features/Budget/
        Usage Log — the ones CLAUDE.md §5 exempts from custom-view work)
        now carry that same base.group_system restriction individually
        instead, so they stay exactly as locked down as before; every
        other AI submenu (Agents, Predictions, Action Requests,
        Permissions, WhatsApp — each already declares its own `groups`
        in its owning module) is reachable again for whichever role its
        own menu already names.
    -->
    <menuitem id="menu_deployfleet_ai_root"
              name="AI"
              parent="deployfleet_core.menu_deployfleet_root"
              sequence="80"/>
    <menuitem id="menu_deployfleet_ai_policy" name="Policy" parent="menu_deployfleet_ai_root"
              action="action_deployfleet_ai_policy" groups="base.group_system" sequence="10"/>
    <menuitem id="menu_deployfleet_ai_config" name="Configuration" parent="menu_deployfleet_ai_root"
              action="action_deployfleet_ai_config" groups="base.group_system" sequence="20"/>
    <menuitem id="menu_deployfleet_ai_feature" name="Features" parent="menu_deployfleet_ai_root"
              action="action_deployfleet_ai_feature" groups="base.group_system" sequence="30"/>
    <menuitem id="menu_deployfleet_ai_budget" name="Budget" parent="menu_deployfleet_ai_root"
              action="action_deployfleet_ai_budget" groups="base.group_system" sequence="40"/>
    <menuitem id="menu_deployfleet_ai_usage" name="Usage Log" parent="menu_deployfleet_ai_root"
              action="action_deployfleet_ai_usage" groups="base.group_system" sequence="50"/>
    <menuitem id="menu_deployfleet_ai_company_profile" name="Company Profile" parent="menu_deployfleet_ai_root"
              action="action_deployfleet_ai_company_profile" groups="base.group_system" sequence="60"/>
</odoo>
