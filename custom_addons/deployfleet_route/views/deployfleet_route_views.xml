<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_deployfleet_route_form" model="ir.ui.view">
        <field name="name">deployfleet.route.form</field>
        <field name="model">deployfleet.route</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="origin_depot_id"/>
                        <field name="destination_depot_id"/>
                        <field name="distance_km"/>
                        <field name="company_id"/>
                    </group>
                    <field name="stop_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="depot_id"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_deployfleet_route_list" model="ir.ui.view">
        <field name="name">deployfleet.route.list</field>
        <field name="model">deployfleet.route</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="origin_depot_id"/>
                <field name="destination_depot_id"/>
                <field name="distance_km"/>
            </list>
        </field>
    </record>

    <record id="action_deployfleet_route" model="ir.actions.act_window">
        <field name="name">Routes</field>
        <field name="res_model">deployfleet.route</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_deployfleet_route"
              name="Routes"
              parent="deployfleet_core.menu_deployfleet_root"
              action="action_deployfleet_route"
              groups="deployfleet_security.group_deployfleet_dispatcher"
              sequence="50"/>
</odoo>
