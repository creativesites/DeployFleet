<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_deployfleet_depot_form" model="ir.ui.view">
        <field name="name">deployfleet.depot.form</field>
        <field name="model">deployfleet.depot</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="street"/>
                        <field name="city"/>
                        <field name="company_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_deployfleet_depot_list" model="ir.ui.view">
        <field name="name">deployfleet.depot.list</field>
        <field name="model">deployfleet.depot</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="city"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="action_deployfleet_depot" model="ir.actions.act_window">
        <field name="name">Depots</field>
        <field name="res_model">deployfleet.depot</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_deployfleet_depot"
              name="Depots"
              parent="deployfleet_core.menu_deployfleet_root"
              action="action_deployfleet_depot"
              groups="deployfleet_security.group_deployfleet_dispatcher"
              sequence="40"/>
</odoo>
