<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_deployfleet_contract" model="ir.sequence">
        <field name="name">DeployFleet Contract</field>
        <field name="code">deployfleet.contract</field>
        <field name="prefix">CNT</field>
        <field name="padding">5</field>
    </record>

    <record id="ir_cron_deployfleet_contract_expiry" model="ir.cron">
        <field name="name">DeployFleet: expire contracts past end date</field>
        <field name="model_id" ref="model_deployfleet_contract"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire_contracts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
