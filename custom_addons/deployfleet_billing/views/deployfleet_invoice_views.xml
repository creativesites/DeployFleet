<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_deployfleet_invoice_form" model="ir.ui.view">
        <field name="name">deployfleet.invoice.form</field>
        <field name="model">deployfleet.invoice</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="customer_id"/>
                            <field name="contract_id"/>
                            <field name="trip_id"/>
                        </group>
                        <group>
                            <field name="invoice_date"/>
                            <field name="currency_id" groups="base.group_multi_company"/>
                            <field name="amount_total"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="shipment_id"/>
                            <field name="description"/>
                            <field name="quantity"/>
                            <field name="unit_amount"/>
                            <field name="subtotal"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_deployfleet_invoice_list" model="ir.ui.view">
        <field name="name">deployfleet.invoice.list</field>
        <field name="model">deployfleet.invoice</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="invoice_date"/>
                <field name="amount_total"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_deployfleet_invoice" model="ir.actions.act_window">
        <field name="name">Invoices</field>
        <field name="res_model">deployfleet.invoice</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_deployfleet_invoice"
              name="Invoices"
              parent="deployfleet_billing.menu_deployfleet_billing_root"
              action="action_deployfleet_invoice"
              groups="deployfleet_security.group_deployfleet_dispatcher"
              sequence="10"/>
</odoo>
