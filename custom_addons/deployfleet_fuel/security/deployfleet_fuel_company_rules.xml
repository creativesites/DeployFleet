<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Engineering-audit fix (C-01): deployfleet.fuel.log had no
        company_id field, or any ir.rule, at all.
    -->
    <record id="deployfleet_fuel_log_rule_company" model="ir.rule">
        <field name="name">Fuel Log: multi-company</field>
        <field name="model_id" ref="model_deployfleet_fuel_log"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!--
        Engineering-audit fix (H-03): the driver group's own ACL grants
        create (and read), but with no check tying the log to the
        driver's own vehicle - any driver could log fuel against ANY
        vehicle in the fleet, polluting cost/consumption and the
        fuel-anomaly z-score model with misattributed data. Requiring
        vehicle_id.current_driver_id to be the creating user applies to
        create too (ir.rule domains are checked post-write on create by
        default), so a driver can now only log fuel for the vehicle
        currently assigned to them.
    -->
    <record id="deployfleet_fuel_log_rule_driver_own_vehicle" model="ir.rule">
        <field name="name">Driver: fuel logs for their own current vehicle only</field>
        <field name="model_id" ref="model_deployfleet_fuel_log"/>
        <field name="domain_force">[('vehicle_id.current_driver_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('deployfleet_security.group_deployfleet_driver'))]"/>
    </record>

    <record id="deployfleet_fuel_log_rule_dispatcher_all" model="ir.rule">
        <field name="name">Dispatcher/Manager/Owner: all fuel logs</field>
        <field name="model_id" ref="model_deployfleet_fuel_log"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('deployfleet_security.group_deployfleet_dispatcher'))]"/>
    </record>
</odoo>
