<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_deployfleet_fuel_log_form" model="ir.ui.view">
        <field name="name">deployfleet.fuel.log.form</field>
        <field name="model">deployfleet.fuel.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="vehicle_id"/>
                            <field name="driver_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="odometer"/>
                            <field name="liters"/>
                            <field name="total_cost"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                    </group>
                    <group string="Consumption">
                        <field name="distance_since_last_km"/>
                        <field name="consumption_l_per_100km"/>
                        <field name="is_anomaly"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_deployfleet_fuel_log_list" model="ir.ui.view">
        <field name="name">deployfleet.fuel.log.list</field>
        <field name="model">deployfleet.fuel.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="vehicle_id"/>
                <field name="date"/>
                <field name="liters"/>
                <field name="total_cost"/>
                <field name="consumption_l_per_100km"/>
                <field name="is_anomaly" widget="boolean_toggle" decoration-danger="is_anomaly"/>
            </list>
        </field>
    </record>

    <record id="action_deployfleet_fuel_log" model="ir.actions.act_window">
        <field name="name">Fuel Logs</field>
        <field name="res_model">deployfleet.fuel.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_deployfleet_fuel_log"
              name="Fuel Logs"
              parent="deployfleet_core.menu_deployfleet_root"
              action="action_deployfleet_fuel_log"
              groups="deployfleet_security.group_deployfleet_dispatcher"
              sequence="30"/>
</odoo>
