<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_deployfleet_maintenance_schedule_form" model="ir.ui.view">
        <field name="name">deployfleet.maintenance.schedule.form</field>
        <field name="model">deployfleet.maintenance.schedule</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_job_card" type="object" string="Create Job Card"
                            invisible="not is_due" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="vehicle_id"/>
                            <field name="name"/>
                            <field name="is_due"/>
                        </group>
                        <group>
                            <field name="interval_km"/>
                            <field name="interval_days"/>
                            <field name="last_service_odometer"/>
                            <field name="last_service_date"/>
                            <field name="next_due_odometer"/>
                            <field name="next_due_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_deployfleet_maintenance_schedule_list" model="ir.ui.view">
        <field name="name">deployfleet.maintenance.schedule.list</field>
        <field name="model">deployfleet.maintenance.schedule</field>
        <field name="arch" type="xml">
            <list>
                <field name="vehicle_id"/>
                <field name="name"/>
                <field name="next_due_odometer"/>
                <field name="next_due_date"/>
                <field name="is_due" widget="boolean_toggle" decoration-danger="is_due"/>
            </list>
        </field>
    </record>

    <record id="action_deployfleet_maintenance_schedule" model="ir.actions.act_window">
        <field name="name">Maintenance Schedules</field>
        <field name="res_model">deployfleet.maintenance.schedule</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_deployfleet_maintenance_schedule"
              name="Maintenance"
              parent="deployfleet_core.menu_deployfleet_root"
              action="action_deployfleet_maintenance_schedule"
              groups="deployfleet_security.group_deployfleet_dispatcher"
              sequence="45"/>
</odoo>
