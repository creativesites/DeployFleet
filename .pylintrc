[MASTER]
load-plugins=pylint_odoo
ignore=.local,mobile
# CI's lint job intentionally never installs the odoo package itself (it
# only needs ruff/pylint/pylint-odoo to lint custom_addons against the
# Odoo APIs, not to run Odoo) — so pylint can never resolve `import odoo`
# or its submodules. Without this, every single model/view/test file in
# every module raises import-error (E0401), which fails the job on code
# that is otherwise correct. This is the standard fix for linting Odoo
# addons without a full Odoo installation present.
ignored-modules=odoo,werkzeug

[ODOOLINT]
manifest-required-authors=DeployFleet
manifest-required-keys=name,version,depends,license
valid-odoo-versions=19.0

[MESSAGES CONTROL]
# pylint-odoo's defaults are the point of running it; only silence checks
# that don't apply to this repo's layout or fight idioms inherent to Odoo
# module structure (calling a model's own "_private" helpers on a fresh
# recordset is completely normal, not an encapsulation violation) or to
# unittest (setUp/setUpClass are framework-mandated names, not a style choice).
disable=missing-docstring,too-few-public-methods,protected-access,broad-exception-caught,invalid-name,duplicate-code
# duplicate-code (R0801) flags manifest boilerplate (author/license/data
# key structure) and test-fixture setup (the "create a fleet.vehicle.model
# if none exists" helper) that legitimately repeats across independently
# installable modules — OCA convention keeps each module self-contained
# rather than depending on a shared test-helper or manifest-generation
# module. That coupling would cost more than the few repeated lines it
# saves, so this is silenced deliberately, not overlooked.

[FORMAT]
max-line-length=120

[DESIGN]
max-args=8
max-positional-arguments=8
max-locals=25
