# Copy to .env and fill in local values. Never commit the real .env file.

# PostgreSQL
POSTGRES_DB=deployfleet
POSTGRES_USER=deployfleet
POSTGRES_PASSWORD=changeme_local_dev_only

# Odoo
ODOO_HTTP_PORT=8169
ODOO_LONGPOLLING_PORT=8172

# deployfleet_ai_core does NOT read provider keys from the environment —
# these vars are not wired to anything and setting them here has no
# effect. Provider credentials live on the deployfleet.ai.config record
# (one per company), set via Settings > DeployFleet AI Config in the
# Odoo backend, or loaded as data on a fresh install. Kept here only as
# a reminder of which providers exist; do not "fix" this by having code
# read these instead — a DB-stored, per-company credential is the
# correct design (see docs/architecture/08-ai-architecture.md).
