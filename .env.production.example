# Copy to .env.production on the machine running scripts/deploy-demo.sh
# (or generate it there directly) and fill in real values. Never commit
# .env.production itself — it's gitignored specifically because this file
# holds production credentials, unlike .env.example.

# SSH access to the demo server — prefer a key over a password.
DEPLOYFLEET_DEMO_SSH_HOST=199.192.23.46
DEPLOYFLEET_DEMO_SSH_USER=root
DEPLOYFLEET_DEMO_SSH_KEY=

# PostgreSQL — a dedicated database/user for DeployFleet, distinct from
# whatever the existing production/staging Odoo instances use.
POSTGRES_DB=deployfleet_prod
POSTGRES_USER=deployfleet_prod
POSTGRES_PASSWORD=

# Odoo — ports must be confirmed free via scripts/preflight-inventory.sh
# before first deploy. Do not default these to the same ports used by
# deploy/docker-compose.yml (local dev) or guess at what's already in use
# on the shared server.
DEPLOYFLEET_HTTP_PORT=
DEPLOYFLEET_LONGPOLLING_PORT=
DEPLOYFLEET_ODOO_MASTER_PASSWORD=

# Remote path where the DeployFleet repo/stack lives on the demo server.
DEPLOYFLEET_REMOTE_DIR=/opt/deployfleet
